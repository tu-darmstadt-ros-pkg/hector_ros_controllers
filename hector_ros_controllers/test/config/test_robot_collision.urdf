<?xml version="1.0" encoding="UTF-8"?>
<robot name="test_robot_collision">
  <link name="base_link">
    <collision>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
  </link>
  <link name="link1">
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </collision>
  </link>
  <link name="link2">
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
  </link>
  <link name="link3">
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
  </link>
  <link name="link4">
    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <sphere radius="0.12"/>
      </geometry>
    </collision>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="1.0"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="5.0" velocity="2.0"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="3.0" velocity="1.5"/>
  </joint>
  <joint name="joint4" type="continuous">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="2.0" velocity="3.0"/>
  </joint>
</robot>
