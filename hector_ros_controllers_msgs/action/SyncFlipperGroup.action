# Sync flipper pairs by driving each joint to the average position of its group.
# Supports syncing multiple groups simultaneously. Empty group_names = sync ALL groups.
# Cancels immediately if a velocity command arrives for any joint in a synced group.

# Goal
string[] group_names        # groups to sync; empty = sync all groups
float64 max_velocity        # max velocity in rad/s (0 = use max_action_velocity parameter)
float64 max_acceleration    # max acceleration in rad/s^2 (0 = use max_action_acceleration parameter)
---
# Result
bool success
string message
float64[] synced_positions  # one per group, in order of group_names
---
# Feedback
float64 progress            # 0.0 to 1.0 (slowest group)
float64 max_position_error  # worst deviation from target across all groups
